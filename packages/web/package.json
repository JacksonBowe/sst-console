		"vue",
		"vuejs"
	],
	"author": "JacksonBowe <jacksonbowe98@gmail.com>",
	"type": "module",
	"scripts": {
		"format": "oxfmt --config ../../oxfmt.config.ts",
		"format:check": "oxfmt --check --config ../../oxfmt.config.ts",
