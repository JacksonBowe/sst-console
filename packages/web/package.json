		"vue-router": "^5.0.6"
	},
	"devDependencies": {
		"@quasar/app-vite": "^3.10.0",
		"@types/node": "^22.19.11",
		"@vitejs/plugin-vue": "^6.0.9",
		"@vue/test-utils": "^2.5.1",
		"autoprefixer": "^10.4.27",
		"happy-dom": "^20.14.5",
		"oxfmt": "^0.x",
		"oxlint": "^1.x",
		"oxlint-tsgolint": "^7.0.2001",
